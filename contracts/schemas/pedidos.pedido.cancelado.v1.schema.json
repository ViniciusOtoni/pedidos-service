{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:pedidos.pedido.cancelado.v1",
  "title": "PedidoCancelado",
  "description": "Gerado por edp-contracts a partir de urn:datacontract:pedidos:pedido:v1 v1.2.0 (objeto pedido_cancelado). Não editar manualmente.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "pedido_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 2
    },
    "motivo": {
      "type": "string",
      "enum": [
        "CLIENTE_DESISTIU",
        "PAGAMENTO_RECUSADO",
        "FRAUDE"
      ]
    },
    "cancelado_por": {
      "type": "string",
      "enum": [
        "CLIENTE",
        "SISTEMA"
      ]
    },
    "cancelado_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pedido_id",
    "aggregate_version",
    "motivo",
    "cancelado_por",
    "cancelado_em"
  ]
}
