{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:pedidos.pedido.confirmado.v1",
  "title": "PedidoConfirmado",
  "description": "Gerado por edp-contracts a partir de urn:datacontract:pedidos:pedido:v1 v1.1.0 (objeto pedido_confirmado). Não editar manualmente.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "pedido_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMADO"
      ]
    },
    "confirmado_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "pedido_id",
    "aggregate_version",
    "status",
    "confirmado_em"
  ]
}
